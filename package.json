{
  "name": "pitwall-analytics",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "api",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w @pitwall/api\" \"npm run dev -w @pitwall/web\"",
    "dev:web": "npm run dev -w @pitwall/web",
    "dev:api": "npm run dev -w @pitwall/api",
    "build": "npm run build -w @pitwall/web",
    "preview": "npm run preview -w @pitwall/web",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "validate:data": "npm run validate:data -w @pitwall/shared"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "concurrently": "^10.0.0",
    "eslint": "^10.12.0",
    "typescript": "^5.9.3"
  }
}
